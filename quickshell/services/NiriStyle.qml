pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs

// Writes the style-dependent part of niri's config (window borders, corner radius) to
// ~/.config/niri/ansai-style.kdl, which config.kdl includes last; niri reloads it live.
Singleton {
    id: root

    function hex(c: color, a: real): string {
        const h = v => Math.round(v * 255).toString(16).padStart(2, "0");
        return "#" + h(c.r) + h(c.g) + h(c.b) + h(a);
    }

    readonly property string text: {
        const m3 = Theme.m3, dark = Theme.dark;
        const w = m3 ? 2 : 1;
        // Light theme: a white edge reads better on a bright wallpaper than a tinted one.
        const active = !dark ? "#ffffffe6" : m3 ? hex(Theme.accent, 1) : "#ffffff2e";
        const inactive = !dark ? "#ffffff66" : m3 ? hex(Theme.line, 0.6) : "#ffffff12";
        const r = m3 ? 24 : 16;   // ansai: macOS 27 unified window radius
        return `// Generated by ansai-shell (services/NiriStyle.qml) for style "${Settings.style}", theme "${Settings.theme}". Edits are overwritten.
layout {
    border {
        width ${w}
        active-color "${active}"
        inactive-color "${inactive}"
    }
}
window-rule {
    geometry-corner-radius ${r}
}
layer-rule {
    match namespace="^ansai-(launcher|control|calendar|power|polkit|toasts|osd|appmenu)$"
    geometry-corner-radius ${m3 ? 28 : 24}
}
${m3 ? "" : `
// ansai Liquid Glass: soft, light shadows whose corners match each surface (a mismatched radius
// shows as a dark outline), and a light, saturated blur so the backdrop stays recognisable.
layer-rule {
    match namespace="^ansai-(launcher|control|calendar|power|polkit|toasts|osd|appmenu|system|dockmenu)$"
    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=10
        color "#00000038"
    }
}
layer-rule {
    match namespace="^ansai-toasts$"
    // niri clips the toast's blur to this radius without antialiasing; rounder than the 22px card
    // keeps the steps inside the card instead of on its edge.
    geometry-corner-radius 30
}
layer-rule {
    match namespace="^ansai-(appmenu|system|dockmenu)$"
    geometry-corner-radius 12
}
layer-rule {
    match namespace="^ansai-osd$"
    geometry-corner-radius 16
}
blur {
    passes 2
    offset 2.5
    saturation 1.6
}
`}`;
    }
    onTextChanged: write.restart()

    Timer {
        id: write
        interval: 400
        running: true
        onTriggered: file.setText(root.text)
    }

    FileView {
        id: file
        path: (Quickshell.env("XDG_CONFIG_HOME") || Quickshell.env("HOME") + "/.config") + "/niri/ansai-style.kdl"
        atomicWrites: true
        blockLoading: false
        printErrors: false
    }
}
