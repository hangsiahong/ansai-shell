pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs

// Makes apps match the shell: GTK4/libadwaita and GTK3 (adw-gtk3) colours, dark/light preference,
// accent and UI font via gsettings, and Ghostty light/dark themes. Rewritten whenever Theme changes.
// First run backs up what it replaces to ~/.config/ansai-shell/system-theme-backup (with restore.sh).
Singleton {
    id: root

    readonly property bool enabled: Settings.systemTheme
    readonly property string home: Quickshell.env("HOME")
    readonly property string cfg: Quickshell.env("XDG_CONFIG_HOME") || home + "/.config"
    readonly property string backup: Settings.dir + "/system-theme-backup"
    property bool ready: false   // backup done

    function hex(x): string {
        const c = Qt.color(x);
        const h = v => Math.round(Math.max(0, Math.min(1, v)) * 255).toString(16).padStart(2, "0");
        return "#" + h(c.r) + h(c.g) + h(c.b);
    }
    // Translucent token over a base, flattened: GTK themes want solid colours.
    function flat(x, y): string {
        const c = Qt.color(x), base = Qt.color(y);
        const a = c.a;
        return hex(Qt.rgba(c.r * a + base.r * (1 - a), c.g * a + base.g * (1 - a), c.b * a + base.b * (1 - a), 1));
    }

    readonly property var c: {
        const T = Theme, d = T.dark;
        const bg = T.m3 ? T.surface : d ? "#1c1c1e" : "#f2f2f7";
        const view = T.m3 ? T.bg : d ? "#000000" : "#ffffff";
        return {
            accent: hex(T.accent),
            accentFg: hex(T.accentInk),
            accentText: hex(T.m3 ? T.accent : d ? "#0a84ff" : "#007aff"),
            danger: hex(T.danger),
            green: hex(T.green),
            warn: hex(T.warn),
            window: hex(bg),
            windowFg: hex(T.text),
            view: hex(view),
            header: hex(T.m3 ? T.surface : d ? "#1c1c1e" : "#f2f2f7"),
            sidebar: hex(T.m3 ? T.surface2 : d ? "#121214" : "#e9e9ee"),
            card: hex(T.m3 ? T.surface2 : d ? "#2c2c2e" : "#ffffff"),
            popover: hex(T.m3 ? T.surface3 : d ? "#2c2c2e" : "#ffffff"),
            dialog: hex(T.m3 ? T.surface2 : d ? "#2c2c2e" : "#ffffff"),
            border: flat(T.line, bg),
            muted: flat(T.muted, bg)
        };
    }

    readonly property string gtk3: `/* Generated by ansai-shell (services/SystemTheme.qml). Edits are overwritten; backup in ${backup}. */
@define-color accent_color ${c.accentText};
@define-color accent_bg_color ${c.accent};
@define-color accent_fg_color ${c.accentFg};
@define-color destructive_color ${c.danger};
@define-color destructive_bg_color ${c.danger};
@define-color destructive_fg_color #ffffff;
@define-color success_color ${c.green};
@define-color warning_color ${c.warn};
@define-color error_color ${c.danger};
@define-color window_bg_color ${c.window};
@define-color window_fg_color ${c.windowFg};
@define-color view_bg_color ${c.view};
@define-color view_fg_color ${c.windowFg};
@define-color headerbar_bg_color ${c.header};
@define-color headerbar_fg_color ${c.windowFg};
@define-color headerbar_border_color ${c.border};
@define-color headerbar_backdrop_color ${c.window};
@define-color sidebar_bg_color ${c.sidebar};
@define-color sidebar_fg_color ${c.windowFg};
@define-color sidebar_backdrop_color ${c.sidebar};
@define-color sidebar_border_color ${c.border};
@define-color card_bg_color ${c.card};
@define-color card_fg_color ${c.windowFg};
@define-color dialog_bg_color ${c.dialog};
@define-color dialog_fg_color ${c.windowFg};
@define-color popover_bg_color ${c.popover};
@define-color popover_fg_color ${c.windowFg};
@define-color borders ${c.border};
`
    readonly property string gtk4: gtk3 + `
:root {
  --accent-color: ${c.accentText};
  --accent-bg-color: ${c.accent};
  --accent-fg-color: ${c.accentFg};
  --destructive-color: ${c.danger};
  --destructive-bg-color: ${c.danger};
  --success-color: ${c.green};
  --warning-color: ${c.warn};
  --error-color: ${c.danger};
  --window-bg-color: ${c.window};
  --window-fg-color: ${c.windowFg};
  --view-bg-color: ${c.view};
  --view-fg-color: ${c.windowFg};
  --headerbar-bg-color: ${c.header};
  --headerbar-fg-color: ${c.windowFg};
  --headerbar-border-color: ${c.border};
  --headerbar-backdrop-color: ${c.window};
  --sidebar-bg-color: ${c.sidebar};
  --sidebar-fg-color: ${c.windowFg};
  --sidebar-backdrop-color: ${c.sidebar};
  --sidebar-border-color: ${c.border};
  --secondary-sidebar-bg-color: ${c.window};
  --card-bg-color: ${c.card};
  --card-fg-color: ${c.windowFg};
  --dialog-bg-color: ${c.dialog};
  --dialog-fg-color: ${c.windowFg};
  --popover-bg-color: ${c.popover};
  --popover-fg-color: ${c.windowFg};
  --thumbnail-bg-color: ${c.card};
}
`

    // ---- Ghostty: one theme per scheme; the config picks by system dark/light, so switching is live.
    function term(dark: bool): string {
        const P = Scheme;
        let bg, fg, ansi;
        if (Theme.m3) {
            const t = dark ? 72 : 42, t2 = dark ? 82 : 34, ch = 46;
            const hues = [25, 145, 85, P.hue, 320, 200];
            ansi = [hex(P.n(dark ? 20 : 30)), ...hues.map(h => hex(P.tone(h, ch, t, 1))), hex(P.n(dark ? 85 : 80)),
                    hex(P.n(dark ? 40 : 50)), ...hues.map(h => hex(P.tone(h, ch, t2, 1))), hex(P.n(dark ? 98 : 95))];
            bg = hex(P.n(dark ? 6 : 98));
            fg = hex(P.n(dark ? 90 : 10));
        } else if (dark) {
            ansi = ["#1c1c1e", "#ff453a", "#30d158", "#ffd60a", "#0a84ff", "#bf5af2", "#64d2ff", "#d1d1d6",
                    "#636366", "#ff6961", "#4cd964", "#ffe066", "#409cff", "#da8fff", "#8ae0ff", "#ffffff"];
            bg = "#0b0d11";
            fg = "#ffffff";
        } else {
            ansi = ["#3a3a3c", "#d70015", "#248a3d", "#b25000", "#0040dd", "#8944ab", "#0071a4", "#8e8e93",
                    "#636366", "#ff3b30", "#34c759", "#c93400", "#007aff", "#af52de", "#0a84ff", "#1c1c1e"];
            bg = "#ffffff";
            fg = "#000000";
        }
        const accent = hex(dark === Theme.dark ? Theme.accent : (Theme.m3 ? P.p(dark ? 80 : 40) : dark ? "#0a84ff" : "#007aff"));
        return `# Generated by ansai-shell (services/SystemTheme.qml). Edits are overwritten.
${ansi.map((a, i) => `palette = ${i}=${a}`).join("\n")}
background = ${bg}
foreground = ${fg}
cursor-color = ${accent}
selection-background = ${accent}
selection-foreground = ${dark ? "#000000" : "#ffffff"}
`;
    }

    // Nearest GNOME accent, for apps that only read the gsettings enum (portal-aware browsers etc.).
    readonly property string gnomeAccent: {
        const a = Theme.accent;
        if (a.hslSaturation < 0.18) return "slate";
        const h = a.hslHue * 360;
        return h < 15 || h >= 345 ? "red" : h < 45 ? "orange" : h < 70 ? "yellow" : h < 160 ? "green"
             : h < 200 ? "teal" : h < 255 ? "blue" : h < 290 ? "purple" : "pink";
    }

    readonly property string stamp: enabled ? [gtk4, term(true), term(false), Theme.dark, gnomeAccent, Theme.fontName].join("|") : ""
    onStampChanged: if (ready && enabled) apply.restart()
    onReadyChanged: if (ready && enabled) apply.restart()

    Timer {
        id: apply
        interval: 600
        onTriggered: {
            gtk4File.setText(root.gtk4);
            gtk3File.setText(root.gtk3);
            termDark.setText(root.term(true));
            termLight.setText(root.term(false));
            Quickshell.execDetached(["sh", "-c",
                `gsettings set org.gnome.desktop.interface color-scheme '${Theme.dark ? "prefer-dark" : "default"}';` +
                `gsettings set org.gnome.desktop.interface gtk-theme '${Theme.dark ? "adw-gtk3-dark" : "adw-gtk3"}';` +
                `gsettings set org.gnome.desktop.interface accent-color '${root.gnomeAccent}';` +
                `gsettings set org.gnome.desktop.interface font-name '${Theme.fontName} 10';` +
                `gsettings set org.gnome.desktop.interface document-font-name '${Theme.fontName} 10'`]);
        }
    }

    // One-time backup of everything this replaces, plus a restore script; also points Ghostty at our themes.
    Process {
        running: root.enabled
        command: ["sh", "-c", `
set -e
B='${root.backup}'; C='${root.cfg}'
if [ ! -e "$B/done" ]; then
  mkdir -p "$B"
  for f in gtk-3.0/gtk.css gtk-4.0/gtk.css ghostty/config; do
    [ -e "$C/$f" ] && mkdir -p "$B/$(dirname $f)" && cp -a "$C/$f" "$B/$f"
  done
  : > "$B/gsettings.txt"
  for k in color-scheme gtk-theme accent-color font-name document-font-name; do
    echo "$k $(gsettings get org.gnome.desktop.interface $k)" >> "$B/gsettings.txt"
  done
  cat > "$B/restore.sh" <<'EOS'
#!/bin/sh
# Puts back what ansai-shell's system theme replaced. Turn it off first (settings.json "systemTheme": false).
B="$(cd "$(dirname "$0")" && pwd)"; C="\${XDG_CONFIG_HOME:-$HOME/.config}"
for f in gtk-3.0/gtk.css gtk-4.0/gtk.css ghostty/config; do [ -e "$B/$f" ] && cp -a "$B/$f" "$C/$f"; done
while read -r k v; do gsettings set org.gnome.desktop.interface "$k" "$v"; done < "$B/gsettings.txt"
echo restored
EOS
  chmod +x "$B/restore.sh"
  if [ -e "$C/ghostty/config" ]; then
    if grep -q '^theme *=' "$C/ghostty/config"; then
      sed -i 's/^theme *=.*/theme = light:ansai-light,dark:ansai-dark/' "$C/ghostty/config"
    else
      printf '\\ntheme = light:ansai-light,dark:ansai-dark\\n' >> "$C/ghostty/config"
    fi
  fi
  touch "$B/done"
fi
mkdir -p "$C/gtk-3.0" "$C/gtk-4.0" "$C/ghostty/themes"
`]
        onExited: (code) => { if (code === 0) root.ready = true; }
    }

    FileView { id: gtk4File; path: root.cfg + "/gtk-4.0/gtk.css"; blockLoading: false; printErrors: false; atomicWrites: true }
    FileView { id: gtk3File; path: root.cfg + "/gtk-3.0/gtk.css"; blockLoading: false; printErrors: false; atomicWrites: true }
    FileView { id: termDark; path: root.cfg + "/ghostty/themes/ansai-dark"; blockLoading: false; printErrors: false; atomicWrites: true }
    FileView { id: termLight; path: root.cfg + "/ghostty/themes/ansai-light"; blockLoading: false; printErrors: false; atomicWrites: true }
}
